<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mysports.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.mysports.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.mysports.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/mySportsFragment"
        android:name="com.example.mysports.MySportsFragment"
        android:label="My Sports"
        tools:layout="@layout/fragment_my_sports">

        <action
            android:id="@+id/action_mySports_to_basketball"
            app:destination="@id/basketballFragment" />
        <action
            android:id="@+id/action_mySports_to_soccer"
            app:destination="@id/soccerFragment" />
        <action
            android:id="@+id/action_mySports_to_tennis"
            app:destination="@id/tennisFragment" />
    </fragment>

    <fragment
        android:id="@+id/basketballFragment"
        android:name="com.example.mysports.BasketballFragment"
        android:label="Basketball"
        tools:layout="@layout/fragment_basketball" />

    <fragment
        android:id="@+id/soccerFragment"
        android:name="com.example.mysports.SoccerFragment"
        android:label="Soccer"
        tools:layout="@layout/fragment_soccer" />

    <fragment
        android:id="@+id/tennisFragment"
        android:name="com.example.mysports.TennisFragment"
        android:label="Tennis"
        tools:layout="@layout/fragment_tennis" />

</navigation>